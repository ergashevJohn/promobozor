# Local Development Environment Variables
# Copy this to .env and fill with your values

# Database (use local or development database)
DATABASE_URL="postgresql://user:password@localhost:5432/promocode_db"

# Base URL (for local development)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# CSRF token signing secret (required in production, min 32 chars)
# Generate with: openssl rand -base64 32
# Legacy alias: NEXTAUTH_SECRET (still accepted temporarily)
CSRF_SECRET="local-dev-csrf-secret-at-least-32-characters"

# Seed system user email (optional) — kept for promocodes.createdById FK
SEED_ADMIN_EMAIL="admin@example.com"

# Google reCAPTCHA v3 (optional but recommended for production)
# Get keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Disable rate limiting (testing only — never use in production)
# RATE_LIMIT_DISABLED="true"

# Disable CSRF checks in development only
# DISABLE_CSRF="true"

# Trusted Types enforcement for production CSP only.
# In development, Trusted Types directives are not sent.
TRUSTED_TYPES_ENFORCE="false"

# Analytics (production)
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# NEXT_PUBLIC_YM_ID="106390376"

# Search Engine Verification Codes (for SEO)
# Get verification codes from:
# - Google Search Console: https://search.google.com/search-console
# - Yandex Webmaster: https://webmaster.yandex.com/
GOOGLE_SITE_VERIFICATION="your-google-site-verification-code"
YANDEX_SITE_VERIFICATION="your-yandex-site-verification-code"

# Optional DB pool tuning (serverless / Supabase transaction pooler)
# Keep low: each Vercel instance opens its own pool against :6543
# DB_POOL_MAX="5"
# DB_POOL_IDLE_TIMEOUT="20"
# DB_POOL_CONNECT_TIMEOUT="15"
# DB_POOL_MAX_LIFETIME="1800"

# Cache revalidation endpoint secret (POST /api/cache/revalidate)
# REVALIDATE_SECRET="your-long-random-secret"
