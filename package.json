{
  "name": "promocode-cite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:prod": "dotenv -e .env.production -- next dev --webpack",
    "build": "npm run test:ci && dotenv -e .env.production -e .env.build -- next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "NODE_ENV=test vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check": "npm run format && npm run lint && npm run build && npm run type-check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx db/seed.ts",
    "db:push:prod": "dotenv -e .env.production -- drizzle-kit push",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:studio:prod": "dotenv -e .env.production -- drizzle-kit studio",
    "seed:prod": "dotenv -e .env.production -- tsx db/seed.ts",
    "slug:migrate:promocodes": "tsx scripts/migrations/update-promocode-slugs.ts",
    "slug:migrate:promocodes:dry": "tsx scripts/migrations/update-promocode-slugs.ts --dry-run",
    "slug:migrate:stores": "tsx scripts/migrations/update-store-slugs.ts",
    "slug:migrate:stores:dry": "tsx scripts/migrations/update-store-slugs.ts --dry-run",
    "slug:migrate:categories": "tsx scripts/migrations/update-category-slugs.ts",
    "slug:migrate:categories:dry": "tsx scripts/migrations/update-category-slugs.ts --dry-run",
    "slug:preview:brands": "tsx scripts/migrations/preview-brand-slugs.ts",
    "seo:verify": "node --import tsx scripts/seo/verify-indexability.ts",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/sanitize-html": "^2.16.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha-v3": "^1.11.0",
    "sanitize-html": "^2.17.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "agentation": "^3.0.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.25",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
